# Eudaimonia Terminal Configuration
# Developer: KJshomay12
# Project: Quaxiom Trade Terminal (Eudaimonia)

# Data Provider Mode: MOCK, LIVE, HISTORICAL, DELAYED
EUDAIMONIA_DATA_MODE=MOCK

# Active Market Data Provider: mock, kite, upstox, dhan
EUDAIMONIA_PROVIDER=mock

# Default Exchange: NSE or BSE
EUDAIMONIA_DEFAULT_EXCHANGE=NSE

# Default Active Underlying: NIFTY, BANKNIFTY, FINNIFTY, SENSEX, RELIANCE, TCS, etc.
EUDAIMONIA_DEFAULT_UNDERLYING=NIFTY

# Timezone (Default: Asia/Kolkata)
EUDAIMONIA_TIMEZONE=Asia/Kolkata

# Risk-free interest rate used for Black-Scholes Greeks (e.g. 0.065 for 6.5% RBI 91-day T-bill)
EUDAIMONIA_RISK_FREE_RATE=0.065

# Data staleness threshold in seconds (ticks older than this trigger stale warning)
EUDAIMONIA_STALE_THRESHOLD_SECONDS=5.0

# Terminal UI Refresh rate in Hertz (updates per second)
EUDAIMONIA_UI_FPS=4

# SQLite Database Path for preferences and watchlists
EUDAIMONIA_DB_PATH=data/eudaimonia.db

# -----------------------------------------------------------------------------
# ZERODHA KITE CONNECT API (Optional - required only if EUDAIMONIA_PROVIDER=kite)
# NOTE: Never commit production credentials into version control!
# -----------------------------------------------------------------------------
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# -----------------------------------------------------------------------------
# UPSTOX V2 API (Optional - required only if EUDAIMONIA_PROVIDER=upstox)
# -----------------------------------------------------------------------------
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# -----------------------------------------------------------------------------
# DHAN HQ API (Optional - required only if EUDAIMONIA_PROVIDER=dhan)
# -----------------------------------------------------------------------------
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
